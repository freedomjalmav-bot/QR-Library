<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Presensi Perpustakaan - SMPN 1 Satui</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/html5-qrcode"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #090e1a; 
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
        } 
        #reader { width: 100% !important; height: 100% !important; border: none !important; }
        #reader video { 
            width: 100% !important; 
            height: 100% !important; 
            object-fit: cover !important; 
            border-radius: 1rem !important;
            transform: scaleX(-1);
        }
        #reader__scan_region { width: 100% !important; height: 100% !important; }
        #reader__dashboard { display: none !important; }

        :fullscreen main, :-webkit-full-screen main {
            max-height: 100vh !important;
            height: 100vh !important;
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen text-slate-200 p-0 sm:p-4">

    <!-- OVERLAY UNLOCK AUDIO & FULLSCREEN -->
    <div id="audioUnlockOverlay" onclick="aktifkanKioskTablet()" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-md flex flex-col items-center justify-center p-6 text-center cursor-pointer transition-opacity duration-300">
        <div class="w-20 h-20 rounded-3xl bg-indigo-600 text-white flex items-center justify-center shadow-2xl shadow-indigo-500/40 mb-5 animate-bounce">
            <i class="fa-solid fa-expand text-3xl"></i>
        </div>
        <h2 class="text-2xl font-extrabold text-white mb-2">Mode Kiosk Perpustakaan</h2>
        <p class="text-slate-400 text-sm max-w-xs mb-6">Sentuh layar untuk mengaktifkan suara sambutan, kamera pemindai, dan mode layar penuh.</p>
        <button class="bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold px-6 py-3.5 rounded-2xl shadow-lg shadow-indigo-600/30 flex items-center gap-2.5 transition">
            <i class="fa-solid fa-volume-high"></i> Aktifkan Suara & Layar Penuh
        </button>
    </div>

    <!-- Input RFID / Barcode Scanner Fisik -->
    <input type="text" id="rfidFocusInput" inputmode="none" autocomplete="off" style="position: absolute; opacity: 0; pointer-events: none;">

    <!-- Frame Aplikasi -->
    <main class="w-full max-w-[440px] h-screen sm:h-[92vh] sm:max-h-[900px] bg-slate-900 sm:rounded-[2.5rem] sm:border-[6px] sm:border-slate-800 shadow-2xl flex flex-col justify-between p-5 relative overflow-hidden">
        
        <!-- Header -->
        <header class="text-center mt-1">
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 mb-2">
                <i class="fa-solid fa-book-open-reader text-xl"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-white tracking-tight">Perpustakaan</h1>
            <p class="text-slate-400 text-xs mt-0.5">SMPN 1 Satui • Pindai Kartu Anggota</p>
            
            <div class="flex items-center justify-center gap-2 mt-3">
                <div id="clockWidget" class="text-xl font-bold text-indigo-400 bg-slate-800/80 px-4 py-1.5 rounded-xl border border-slate-700/60 shadow-inner tracking-wider">
                    --:--:--
                </div>
                <button onclick="tesSuaraManual()" title="Tes Suara" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-400 flex items-center justify-center border border-slate-700 transition">
                    <i id="speakerIcon" class="fa-solid fa-volume-high text-sm"></i>
                </button>
                <button onclick="gantiKamera()" title="Ganti Kamera" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center border border-slate-700 transition">
                    <i class="fa-solid fa-camera-rotate text-sm"></i>
                </button>
                <button onclick="toggleFullscreenManual()" title="Layar Penuh" class="w-10 h-10 rounded-xl bg-slate-800 hover:bg-slate-700 text-indigo-400 flex items-center justify-center border border-slate-700 transition">
                    <i id="fullscreenIcon" class="fa-solid fa-expand text-sm"></i>
                </button>
            </div>
        </header>

        <!-- Status Card & Kamera -->
        <section class="my-auto py-2 w-full flex flex-col gap-3">
            <div id="statusCard" class="bg-slate-800 rounded-2xl p-3.5 border border-slate-700 transition-all duration-200 flex items-center gap-3">
                <div id="statusIconBox" class="w-11 h-11 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center shrink-0">
                    <i id="statusIcon" class="fa-solid fa-qrcode text-xl"></i>
                </div>
                <div class="overflow-hidden">
                    <span id="statusBadge" class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-700 text-slate-300 mb-0.5">
                        Siap Memindai
                    </span>
                    <h2 id="statusTitle" class="text-sm font-bold text-white truncate">
                        Arahkan Kartu QR
                    </h2>
                    <p id="statusDesc" class="text-xs text-slate-400 truncate">
                        Tunggu hingga kartu terbaca
                    </p>
                </div>
            </div>

            <div class="bg-slate-800 p-2.5 rounded-3xl shadow-xl w-full border border-slate-700 relative overflow-hidden h-[340px] flex items-center justify-center">
                <div class="bg-black rounded-2xl overflow-hidden relative border border-slate-700/80 w-full h-full flex items-center justify-center">
                    <div id="reader" class="w-full h-full"></div>
                    
                    <div class="absolute inset-0 pointer-events-none flex items-center justify-center z-10">
                        <div id="scanFrame" class="w-48 h-48 border-2 border-indigo-500/40 rounded-3xl relative transition-all duration-200">
                            <div class="absolute -top-1 -left-1 w-7 h-7 border-t-4 border-l-4 border-indigo-400 rounded-tl-2xl"></div>
                            <div class="absolute -top-1 -right-1 w-7 h-7 border-t-4 border-r-4 border-indigo-400 rounded-tr-2xl"></div>
                            <div class="absolute -bottom-1 -left-1 w-7 h-7 border-b-4 border-l-4 border-indigo-400 rounded-bl-2xl"></div>
                            <div class="absolute -bottom-1 -right-1 w-7 h-7 border-b-4 border-r-4 border-indigo-400 rounded-br-2xl"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Footer -->
        <footer class="text-center pb-1 flex items-center justify-between text-xs text-slate-400 px-1">
            <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                Scanner Aktif
            </span>
            <span id="counterText" class="font-bold text-slate-300">0 Hadir</span>
        </footer>

    </main>

    <script>
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyFDpJ85tRdVv-TbxU7XsS2gHEAEE-zsQgiB6EYcf_We_C3aUmrXvsf_DJP2GzHewQ-fw/exec';

        localStorage.clear();

        function updateClock() {
            document.getElementById('clockWidget').innerText = new Date().toLocaleTimeString('id-ID');
        }
        setInterval(updateClock, 1000);
        updateClock();

        // =========================================================================
        // FULLSCREEN
        // =========================================================================
        function masukFullscreen() {
            const elem = document.documentElement;
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                if (elem.requestFullscreen) elem.requestFullscreen().catch(() => {});
                else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
                else if (elem.msRequestFullscreen) elem.msRequestFullscreen();
            }
        }

        function keluarFullscreen() {
            if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
            else if (document.msExitFullscreen) document.msExitFullscreen();
        }

        function toggleFullscreenManual() {
            if (!document.fullscreenElement && !document.webkitFullscreenElement) masukFullscreen();
            else keluarFullscreen();
        }

        function updateFullscreenIcon() {
            const icon = document.getElementById('fullscreenIcon');
            if (!icon) return;
            icon.className = (document.fullscreenElement || document.webkitFullscreenElement) 
                ? "fa-solid fa-compress text-sm" 
                : "fa-solid fa-expand text-sm";
        }
        document.addEventListener('fullscreenchange', updateFullscreenIcon);
        document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);

        // =========================================================================
        // PENGATURAN SUARA & NAMA PENDEK
        // =========================================================================
        let globalAudioCtx = null;
        let suaraIndoTerpilih = null;
        let daftarSuara = [];

        function muatSuaraBahasaIndonesia() {
            if (!('speechSynthesis' in window)) return;
            daftarSuara = window.speechSynthesis.getVoices();
            if (daftarSuara.length > 0) {
                suaraIndoTerpilih = daftarSuara.find(v => v.lang.replace('_', '-').toLowerCase().includes('id-id')) ||
                                    daftarSuara.find(v => v.lang.toLowerCase().includes('id')) ||
                                    daftarSuara.find(v => v.name.toLowerCase().includes('indonesia')) ||
                                    null;
            }
        }

        if ('speechSynthesis' in window) {
            muatSuaraBahasaIndonesia();
            window.speechSynthesis.onvoiceschanged = muatSuaraBahasaIndonesia;
        }

        function aktifkanKioskTablet() {
            masukFullscreen();
            const overlay = document.getElementById('audioUnlockOverlay');
            if (overlay && !overlay.classList.contains('hidden')) {
                overlay.style.opacity = '0';
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }

            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!globalAudioCtx) globalAudioCtx = new AudioContextClass();
                if (globalAudioCtx.state === 'suspended') globalAudioCtx.resume();
            } catch (e) {}

            playBeep(false);
            muatSuaraBahasaIndonesia();
            ucapkanSuara("", "Sistem perpustakaan aktif");
        }

        function tesSuaraManual() {
            playBeep(false);
            muatSuaraBahasaIndonesia();
            ucapkanSuara("", "Selamat Datang di Perpustakaan SMPN 1 Satui");
        }

        function playBeep(isError = false) {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!globalAudioCtx) globalAudioCtx = new AudioContextClass();
                if (globalAudioCtx.state === 'suspended') globalAudioCtx.resume();

                const oscillator = globalAudioCtx.createOscillator();
                const gainNode = globalAudioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(globalAudioCtx.destination);
                oscillator.type = 'sine';
                oscillator.frequency.value = isError ? 300 : 950; 
                gainNode.gain.setValueAtTime(0.5, globalAudioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.001, globalAudioCtx.currentTime + 0.15); 
                oscillator.start(globalAudioCtx.currentTime);
                oscillator.stop(globalAudioCtx.currentTime + 0.15);
            } catch (e) {}
        }

        function bersihkanGelar(nama) {
            if (!nama) return "";
            return nama.replace(/S\.Pd|M\.Pd|S\.Kom|Gr\.|Drs\.|Dra\.|S\.Ag|M\.M|S\.Si|H\.|Hj\./gi, '').replace(/[.,]/g, ' ').trim();
        }

        // Ambil nama pendek (kata pertama dari nama)
        function ambilNamaPendek(nama) {
            if (!nama) return "";
            const namaBersih = bersihkanGelar(nama);
            const kata = namaBersih.split(/\s+/);
            return kata[0] || "";
        }

        function ucapkanSuara(namaUser, pesan) {
            const teksLengkap = namaUser ? `${namaUser}, ${pesan}` : pesan;

            if ('speechSynthesis' in window) {
                try {
                    if (window.speechSynthesis.paused) window.speechSynthesis.resume();
                    if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();

                    setTimeout(() => {
                        if (!suaraIndoTerpilih) muatSuaraBahasaIndonesia();

                        const utterance = new SpeechSynthesisUtterance(teksLengkap);
                        utterance.lang = 'id-ID';
                        utterance.rate = 1.0;
                        utterance.pitch = 1.0;
                        utterance.volume = 1.0;

                        if (suaraIndoTerpilih) utterance.voice = suaraIndoTerpilih;
                        utterance.onerror = () => putarFallbackTTSOnline(teksLengkap);

                        window.speechSynthesis.speak(utterance);
                    }, 60);
                } catch (err) {
                    putarFallbackTTSOnline(teksLengkap);
                }
            } else {
                putarFallbackTTSOnline(teksLengkap);
            }
        }

        function putarFallbackTTSOnline(teks) {
            try {
                const url = `https://translate.google.com/translate_tts?ie=UTF-8&tl=id&client=tw-ob&q=${encodeURIComponent(teks)}`;
                const audio = new Audio(url);
                audio.play().catch(() => {});
            } catch (e) {}
        }

        const statusCard = document.getElementById('statusCard');
        const statusIconBox = document.getElementById('statusIconBox');
        const statusIcon = document.getElementById('statusIcon');
        const statusBadge = document.getElementById('statusBadge');
        const statusTitle = document.getElementById('statusTitle');
        const statusDesc = document.getElementById('statusDesc');
        const scanFrame = document.getElementById('scanFrame');
        let resetTimer = null;
        let hadirCount = 0;

        function tampilkanStatus(tipe, badge, judul, subjudul) {
            clearTimeout(resetTimer);

            if (tipe === 'success') {
                statusCard.className = "bg-emerald-950/80 rounded-2xl p-3.5 border-2 border-emerald-500 shadow-lg transition-all duration-200 flex items-center gap-3";
                statusIconBox.className = "w-11 h-11 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0";
                statusIcon.className = "fa-solid fa-check text-xl";
                statusBadge.className = "inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-900 text-emerald-200 mb-0.5";
                scanFrame.className = "w-48 h-48 border-4 border-emerald-400 bg-emerald-400/10 rounded-3xl relative transition-all duration-150 scale-105";
            } else if (tipe === 'guru') {
                statusCard.className = "bg-purple-950/80 rounded-2xl p-3.5 border-2 border-purple-500 shadow-lg transition-all duration-200 flex items-center gap-3";
                statusIconBox.className = "w-11 h-11 rounded-xl bg-purple-600 text-white flex items-center justify-center shrink-0";
                statusIcon.className = "fa-solid fa-chalkboard-user text-xl";
                statusBadge.className = "inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-900 text-purple-200 mb-0.5";
                scanFrame.className = "w-48 h-48 border-4 border-purple-400 bg-purple-400/10 rounded-3xl relative transition-all duration-150 scale-105";
            } else if (tipe === 'error') {
                statusCard.className = "bg-rose-950/80 rounded-2xl p-3.5 border-2 border-rose-500 shadow-lg transition-all duration-200 flex items-center gap-3";
                statusIconBox.className = "w-11 h-11 rounded-xl bg-rose-500 text-white flex items-center justify-center shrink-0";
                statusIcon.className = "fa-solid fa-xmark text-xl";
                statusBadge.className = "inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-rose-900 text-rose-200 mb-0.5";
                scanFrame.className = "w-48 h-48 border-4 border-rose-500 bg-rose-500/10 rounded-3xl relative transition-all duration-150";
            }

            statusBadge.innerText = badge;
            statusTitle.innerText = judul;
            statusDesc.innerText = subjudul;

            resetTimer = setTimeout(() => {
                statusCard.className = "bg-slate-800 rounded-2xl p-3.5 border border-slate-700 transition-all duration-200 flex items-center gap-3";
                statusIconBox.className = "w-11 h-11 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center shrink-0";
                statusIcon.className = "fa-solid fa-qrcode text-xl";
                statusBadge.className = "inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-700 text-slate-300 mb-0.5";
                statusBadge.innerText = "Siap Memindai";
                statusTitle.innerText = "Arahkan Kartu QR";
                statusDesc.innerText = "Tunggu hingga kartu terbaca";
                scanFrame.className = "w-48 h-48 border-2 border-indigo-500/40 rounded-3xl relative transition-all duration-200";
            }, 2500);
        }

        let lastScannedCode = "";
        let lastScannedTime = 0;

        // =========================================================================
        // PROSES ABSENSI
        // =========================================================================
        function prosesAbsen(payload, namaTampilan, identifierID) {
            playBeep(false);

            const isGuru = payload.tipe === 'guru';
            const labelID = isGuru ? 'NIP' : 'NIS';
            const subJudul = isGuru 
                ? `NIP: ${identifierID} • Dewan Guru` 
                : (identifierID ? `${labelID}: ${identifierID} ${payload.kelas ? '• ' + payload.kelas : ''}` : 'Memverifikasi kartu...');

            tampilkanStatus(
                isGuru ? 'guru' : 'success', 
                isGuru ? 'Presensi Guru' : 'Berhasil', 
                namaTampilan || 'Memproses...', 
                subJudul
            );

            // Pengucapan kalimat sambutan dengan nama pendek
            if (namaTampilan) {
                const namaPendek = ambilNamaPendek(namaTampilan);
                const sapaan = isGuru ? `Bapak Ibu ${namaPendek}` : namaPendek;
                ucapkanSuara("", `Selamat Datang ${sapaan} di Perpustakaan SMPN 1 Satui`);
            }

            hadirCount++;
            document.getElementById('counterText').innerText = `${hadirCount} Hadir`;

            fetch(SCRIPT_URL, { 
                method: 'POST', 
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({ aksi: 'absen', ...payload }) 
            })
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success') {
                    // Jika data diperoleh via server (misal scan kartu RFID)
                    if (!namaTampilan && res.nama) {
                        const tipeRes = (res.tipe || '').toLowerCase() === 'guru';
                        const namaPendekServer = ambilNamaPendek(res.nama);
                        const sapaanServer = tipeRes ? `Bapak Ibu ${namaPendekServer}` : namaPendekServer;

                        tampilkanStatus(
                            tipeRes ? 'guru' : 'success',
                            `${res.tipe || 'Berhasil'} (${res.statusAbsen || 'Masuk'})`,
                            res.nama,
                            `${res.keterangan || res.kelas || 'Perpustakaan SMPN 1 Satui'}`
                        );
                        ucapkanSuara("", `Selamat Datang ${sapaanServer} di Perpustakaan SMPN 1 Satui`);
                    }
                } else {
                    const pesanServer = (res.message || "").toLowerCase();
                    playBeep(true);
                    if (pesanServer.includes('tidak terdaftar') || pesanServer.includes('tidak ditemukan') || pesanServer.includes('tidak ada') || res.status === 'not_found') {
                        tampilkanStatus('error', 'Tidak Terdaftar', namaTampilan || 'QR Tidak Dikenal', res.message || 'Data tidak ditemukan');
                        ucapkanSuara("", "Mohon Maaf, kartu tidak terdaftar");
                    } else {
                        tampilkanStatus('error', 'Sudah Berkunjung', namaTampilan || 'Perhatian', res.message || 'Sudah melakukan presensi hari ini');
                        ucapkanSuara("Maaf " + ambilNamaPendek(namaTampilan), "Anda sudah presensi hari ini");
                    }
                    hadirCount = Math.max(0, hadirCount - 1);
                    document.getElementById('counterText').innerText = `${hadirCount} Hadir`;
                }
            })
            .catch(err => {
                console.error("Gagal menyimpan ke server:", err);
            });
        }

        // =========================================================================
        // DETEKSI SCAN QR
        // =========================================================================
        function tangkapDataScan(decodedText) {
            const now = Date.now();
            if (decodedText === lastScannedCode && (now - lastScannedTime) < 3000) return;
            if ((now - lastScannedTime) < 800) return;

            lastScannedCode = decodedText;
            lastScannedTime = now;

            const raw = decodedText.trim();
            let payloadAbsen = null;
            let namaTampil = "";
            let idTampil = "";

            if (raw.startsWith('{') && raw.endsWith('}')) {
                try {
                    const data = JSON.parse(raw);
                    if (data.nip && data.nama) {
                        payloadAbsen = { tipe: 'guru', nip: String(data.nip).trim(), nama: String(data.nama).trim() };
                        namaTampil = payloadAbsen.nama;
                        idTampil = payloadAbsen.nip;
                    } else if (data.nis && data.nama) {
                        payloadAbsen = { tipe: 'siswa', nis: String(data.nis).trim(), nama: String(data.nama).trim(), kelas: data.kelas ? String(data.kelas).trim() : "" };
                        namaTampil = payloadAbsen.nama;
                        idTampil = payloadAbsen.nis;
                    }
                } catch (e) {}
            }

            if (!payloadAbsen) {
                let nip = "", nis = "", nama = "", kelas = "";
                const barisText = raw.split(/\r?\n/);

                barisText.forEach(baris => {
                    const idxTitikDua = baris.indexOf(':');
                    if (idxTitikDua !== -1) {
                        const kunci = baris.substring(0, idxTitikDua).trim().toUpperCase();
                        const nilai = baris.substring(idxTitikDua + 1).trim();

                        if (kunci === 'NIP') nip = nilai;
                        else if (kunci === 'NIS') nis = nilai;
                        else if (kunci === 'NAMA') nama = nilai;
                        else if (kunci === 'KELAS') kelas = nilai;
                    }
                });

                if (nip && nama) {
                    payloadAbsen = { tipe: 'guru', nip: nip, nama: nama };
                    namaTampil = nama;
                    idTampil = nip;
                } else if (nis && nama) {
                    payloadAbsen = { tipe: 'siswa', nis: nis, nama: nama, kelas: kelas };
                    namaTampil = nama;
                    idTampil = nis;
                }
            }

            if (!payloadAbsen && /^[a-zA-Z0-9\-_]{4,30}$/.test(raw)) {
                payloadAbsen = { rfidUid: raw };
                namaTampil = "";
                idTampil = raw;
            }

            if (payloadAbsen) {
                prosesAbsen(payloadAbsen, namaTampil, idTampil);
            } else {
                playBeep(true);
                tampilkanStatus('error', 'Format Salah', 'QR Tidak Dikenali', 'Gunakan Kartu Anggota resmi');
                ucapkanSuara("", "Mohon Maaf, format kartu tidak dikenali");
            }
        }

        const scanInput = document.getElementById('rfidFocusInput');
        function jagaFokusInput() { scanInput.focus({ preventScroll: true }); }
        window.addEventListener('load', jagaFokusInput);
        document.addEventListener('click', jagaFokusInput);
        setInterval(jagaFokusInput, 1500);

        scanInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                const hasilScan = scanInput.value.trim();
                scanInput.value = ''; 
                if (hasilScan.length > 0) tangkapDataScan(hasilScan); 
            }
        });

        const html5QrCode = new Html5Qrcode("reader");
        let currentFacingMode = "user";

        function mulaiKamera(facingMode) {
            const config = { 
                fps: 30, 
                qrbox: function(w, h) { 
                    const minSize = Math.min(w, h);
                    return { width: Math.floor(minSize * 0.65), height: Math.floor(minSize * 0.65) }; 
                },
                formatsToSupport: [ Html5QrcodeSupportedFormats.QR_CODE ]
            };

            html5QrCode.start(
                { facingMode: facingMode }, 
                config, 
                (decodedText) => tangkapDataScan(decodedText)
            ).catch(err => {
                if (facingMode === "user") {
                    currentFacingMode = "environment";
                    mulaiKamera("environment");
                }
            });
        }

        function gantiKamera() {
            html5QrCode.stop().then(() => {
                currentFacingMode = (currentFacingMode === "user") ? "environment" : "user";
                mulaiKamera(currentFacingMode);
            }).catch(err => console.error(err));
        }

        window.addEventListener('DOMContentLoaded', () => {
            mulaiKamera(currentFacingMode);
        });
    </script>
</body>
</html>
